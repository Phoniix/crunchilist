{
  "manifest_version": 3,
  "name": "Crunchilist",
  "version": "1.0.94",
  "minimum_chrome_version": "114",
  "description": "Search anime by title or mood, get AI-ranked picks, and track what you watch with AniList.",
  "permissions": ["storage", "unlimitedStorage", "identity", "tabs", "webNavigation", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://*.crunchyroll.com/*",
    "https://anilist.co/*",
    "https://graphql.anilist.co/*",
    "https://*.chromiumapp.org/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Crunchilist",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "switch-crunchilist": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Switch between Crunchilist and your Crunchyroll tab"
    }
  },
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://*.crunchyroll.com/*"
      ],
      "js": ["content/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://*.crunchyroll.com/*"
      ],
      "js": ["content/crunchilist.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://static.crunchyroll.com/*"],
      "js": ["content/crunchilist-frame.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/nunito-latin.woff2"],
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://*.crunchyroll.com/*"
      ]
    }
  ]
}
