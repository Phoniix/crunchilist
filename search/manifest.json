{
  "manifest_version": 3,
  "name": "Crunchilist Search",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Find anime across your streaming services and keep your AniList in sync with what you watch.",
  "key": "",
  "permissions": ["storage", "unlimitedStorage", "identity", "scripting", "alarms"],
  "host_permissions": [
    "https://graphql.anilist.co/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://www.netflix.com/*",
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Crunchilist Search",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
